#!/bin/bash
# basic status for a slurm system
#
# takes queue name as argument
#
# one output per line
#
# line 1: up|down
# line 2: running jobs for queue
# line 3: pending (queued) jobs for queue

if [[ $# != 1 ]] ; then
  >&2 echo $0: ERROR: not exactly one argument provided which should the be queue/partition name
  exit -1
fi

QUEUE=$1

## %a is the partition's own admin up/down flag; it stays "up" as long as the
## partition itself is enabled, regardless of how many individual nodes are
## down or drained. %F adds per-partition node counts as
## allocated/idle/other/total. A partition is only really usable when it is
## admin-up AND has at least one allocated or idle node -- checking %a alone
## (the old behavior, ultrascan-tickets#343) reported the whole queue down
## the moment even one node did, while others stayed available.
##
## A row with no AVAIL field at all means sinfo matched nothing for this
## partition (a typo, or a partition that does not exist here), which counts
## as down. ALL sums every partition sinfo knows about; "up" there means at
## least one of them is usable, not that every one of them is.
##
## Only POSIX-portable awk (no gawk-only extensions) and %F, stable in SLURM
## since its 2.x releases: this runs over ssh on whatever login node and
## whatever awk/SLURM build happens to be installed there.
##
## Returns 0 (up), 1 (down, a real reading) or 2 (no reading at all: sinfo
## itself could not be run). The distinction matters because a nonexistent
## partition (a typo, no AVAIL field at all) and a controller outage both
## leave sinfo's stdout empty, but mean different things: the first is a
## real "down" answer (sinfo asked and the controller said this partition
## does not exist), and the second is sinfo never getting an answer to ask
## with at all. Collapsing both into "down" (as a plain zero-rows check did)
## reported a confident "down" during a controller outage instead of no
## answer, skipping cluster_status.php's warn-before-down escalation.
is_up() {
  local out
  out=$( sinfo -h "$@" -o "%a %F" )

  if [[ $? -ne 0 ]] ; then
    return 2
  fi

  echo "$out" | awk '
    {
      split( $2, n, "/" )
      if ( $1 == "up" && ( n[1] + n[2] ) > 0 ) found = 1
    }
    END { exit found ? 0 : 1 }
  '
}

report() {
  is_up "$@"
  case $? in
    0) echo up ;;
    1) echo down ;;
    *) >&2 echo "$0: sinfo could not reach the controller"; exit 1 ;;
  esac
}

if [[ $QUEUE == "ALL" ]] ; then
  report
  squeue -h -a -t running | wc -l
  squeue -h -a -t pending | wc -l
  exit 0
fi

report -p "$QUEUE"
squeue -h -a -p "$QUEUE" -t running | wc -l
squeue -h -a -p "$QUEUE" -t pending | wc -l
